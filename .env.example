# =================================================================
# SAAD MEDICAL STORE — PRODUCTION ENVIRONMENT TEMPLATE
# =================================================================

# Database Connection (PostgreSQL Production Connection Pooler or Direct URL)
# Example: postgresql://user:password@host:5432/saad_medical_store?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/saad_medical_store?schema=public"

# Authentication & Session Security (Min 32 characters random secret)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-very-secure-random-32-byte-hex-or-base64-string"

# Production Domain & Canonical URL
NEXT_PUBLIC_SITE_URL="https://saadmedicalstore.com"

# Public Storefront Branding (Lahore, Pakistan)
NEXT_PUBLIC_APP_NAME="SAAD Medical Store"
NEXT_PUBLIC_APP_TAGLINE="We take care of your health"
NEXT_PUBLIC_STORE_LOCATION="RajGarh Road, Lahore"
NEXT_PUBLIC_PHONE_SHARJEEL="03364085027"
NEXT_PUBLIC_PHONE_SAMEER="03099634214"

# Optional Cloud Storage (Cloudflare R2 / AWS S3 / MinIO) for Prescriptions
# If left unset, falls back to private isolated server storage
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="saad-medical-prescriptions"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"
